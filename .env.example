# Database Configuration
# For Railway: connect your PostgreSQL database and use the DATABASE_URL provided
# For local development: use SQLite or local PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/football_analytics

# Flask Configuration
FLASK_ENV=production

# Security Keys (change these in production!)
SECRET_KEY=your-secret-key-min-32-characters-long
JWT_SECRET_KEY=your-jwt-secret-min-32-characters-long

# Optional: Database connection pool settings
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600
